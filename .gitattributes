# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

#
# The above will handle all files NOT found below
# https://help.github.com/articles/dealing-with-line-endings/
# https://github.com/Danimoth/gitattributes/blob/master/Web.gitattributes



# These files are text and should be normalized (Convert crlf => lf)
*.php text
*.css text
*.scss text
*.js text
*.json text
*.htm text
*.html text
*.xml text
*.txt text
*.ini text
*.inc text
*.pl text
*.rb text
*.py text
*.scm text
*.sql text
.htaccess text
*.sh text
Dockerfile* text
*.yml text
*.yaml text
*.md text
*.markdown text

# These files are binary and should be left untouched
# (binary is a macro for -text -diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.pyc binary

# Personal customizations to these vendored defaultmodules files have already
# diverged from upstream (origin = MagicMirrorOrg/MagicMirror). On `git merge`/
# `git pull` from origin, always keep our version instead of taking upstream's,
# so future upstream commits to these files don't clobber local changes.
# Requires local setup (not carried by this file alone):
#   git config merge.ours.driver true
defaultmodules/calendar/calendarfetcher.js merge=ours
defaultmodules/calendar/calendarfetcherutils.js merge=ours
