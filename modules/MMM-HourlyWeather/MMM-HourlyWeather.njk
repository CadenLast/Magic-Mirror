{% if loaded %}
  <div class="hourly-weather-wrapper">
    {% if current %}
      <div class="current-weather">
        <div class="current-main">
          {% if sunrise %}
            <span class="sun-time"><span class="wi wi-sunrise"></span> {{ sunrise }}</span>
          {% endif %}
          <span class="wi wi-{{ current.icon }} current-icon"></span>
          <span class="current-temp">{{ current.temp }}&deg;</span>
          {% if sunset %}
            <span class="sun-time"><span class="wi wi-sunset"></span> {{ sunset }}</span>
          {% endif %}
        </div>
        <div class="current-details">
          <span>Feels {{ current.feelsLike }}&deg;</span>
          <span><span class="wi wi-strong-wind"></span> {{ current.wind }} mph {{ current.windDir }}</span>
          <span><span class="wi wi-humidity"></span> {{ current.humidity }}%</span>
          {% if current.uv != null %}<span>UV {{ current.uv }}</span>{% endif %}
        </div>
      </div>
    {% endif %}
    <table class="hourly-weather-table">
      <thead>
        <tr>
          <th>Time</th>
          <th></th>
          <th>Temp</th>
          <th>Feels</th>
          <th>Hum</th>
          <th>UV</th>
          <th>Wind</th>
          <th><span class="wi wi-raindrop"></span></th>
        </tr>
      </thead>
      <tbody>
        {% for hour in hours %}
          <tr class="hourly-row">
            <td class="hourly-time">{{ hour.time }}</td>
            <td class="hourly-icon"><span class="wi wi-{{ hour.icon }}"></span></td>
            <td class="hourly-temp">{{ hour.temp }}&deg;</td>
            <td class="hourly-feels">{{ hour.feelsLike }}&deg;</td>
            <td class="hourly-humidity">{{ hour.humidity }}%</td>
            <td class="hourly-uv">
              {% if hour.uv != null %}
                <span class="uv-badge uv-{{ 'low' if hour.uv <= 2 else ('mod' if hour.uv <= 5 else ('high' if hour.uv <= 7 else ('vhigh' if hour.uv <= 10 else 'extreme'))) }}">{{ hour.uv }}</span>
              {% else %}
                —
              {% endif %}
            </td>
            <td class="hourly-wind">{{ hour.wind }} <span class="hourly-wind-dir">{{ hour.windDir }}</span></td>
            <td class="hourly-precip">{{ hour.precipChance if hour.precipChance != null else '—' }}%</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% else %}
  <div class="dimmed light small">Loading hourly forecast...</div>
{% endif %}
